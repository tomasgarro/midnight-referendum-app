pragma language_version 0.23;

import CompactStandardLibrary;

export enum Choice {
  YES,
  NO,
  ABSTAIN,
}

export enum Phase {
  COMMIT,
  REVEAL,
  FINALIZED,
}

// These sealed values bind the referendum to one exact frozen registry
// configuration. They are public metadata, never private voter inputs.
export sealed ledger registryId: Bytes<32>;
export sealed ledger issuerId: Bytes<32>;
export sealed ledger credentialEpoch: Uint<64>;
export sealed ledger frozenCredentialRoot: MerkleTreeDigest;
// Domain-separated hash of the exact registry contract address selected by
// the operator. The address itself is not needed by the voting circuit, but
// retaining its binding prevents an address/root mismatch in public runtime
// configuration from being silently treated as the same registry.
export sealed ledger registryContractBinding: Bytes<32>;
export sealed ledger eventId: Bytes<32>;
export sealed ledger organizerKey: Bytes<32>;

export sealed ledger countryPolicy: Bytes<32>;
export sealed ledger countryPolicyEnabled: Boolean;
export sealed ledger minimumAssurance: Uint<8>;
export sealed ledger requireAdult: Boolean;
// Organizer-selected validity cutoff for credential expiry checks.
export sealed ledger validityReference: Uint<64>;

export ledger ballotCommitments: HistoricMerkleTree<10, Bytes<32>>;
export ledger spentVoteNullifiers: Set<Bytes<32>>;
export ledger revealedCommitments: Set<Bytes<32>>;
export ledger tally: Map<Choice, Uint<32>>;
export ledger phase: Phase;
export ledger closed: Boolean;
export ledger issuedVotes: Counter;

witness organizerSecret(): Bytes<32>;
witness voterSecret(): Bytes<32>;
witness holderBinding(): Bytes<32>;
witness holderBlind(): Bytes<32>;
witness credentialBlind(): Bytes<32>;
witness credentialCountry(): Bytes<32>;
witness credentialAgeClass(): Uint<8>;
witness credentialAssurance(): Uint<8>;
witness credentialClaimEpoch(): Uint<64>;
witness credentialValidUntil(): Uint<64>;
witness voterPath(): MerkleTreePath<16, Bytes<32>>;
witness voterChoice(): Choice;
witness voteSalt(): Bytes<32>;
witness revealPath(): MerkleTreePath<10, Bytes<32>>;

circuit roleKey(domain: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([domain, secret]);
}

circuit holderBindingFromVoter(): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>(
    [pad(32, "cico:holder-bind:v1"), voterSecret()],
    holderBlind()
  );
}


circuit credentialLeaf(): Bytes<32> {
  return persistentCommit<Vector<8, Bytes<32>>>(
    [
      pad(32, "cico:credential:v1"),
      holderBinding(),
      issuerId,
      credentialCountry(),
      credentialAgeClass() as Bytes<32>,
      credentialAssurance() as Bytes<32>,
      credentialClaimEpoch() as Bytes<32>,
      credentialValidUntil() as Bytes<32>
    ],
    credentialBlind()
  );
}

circuit ballotCommitment(choice: Choice, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>(
    [eventId, (choice as Field) as Bytes<32>],
    salt
  );
}

constructor(
  initialRegistryId: Bytes<32>,
  initialIssuerId: Bytes<32>,
  initialCredentialEpoch: Uint<64>,
  initialFrozenCredentialRoot: MerkleTreeDigest,
  initialRegistryContractBinding: Bytes<32>,
  initialEventId: Bytes<32>,
  initialOrganizerKey: Bytes<32>,
  initialCountryPolicy: Bytes<32>,
  initialCountryPolicyEnabled: Boolean,
  initialMinimumAssurance: Uint<8>,
  initialRequireAdult: Boolean,
  initialValidityReference: Uint<64>,
) {
  registryId = disclose(initialRegistryId);
  issuerId = disclose(initialIssuerId);
  credentialEpoch = disclose(initialCredentialEpoch);
  frozenCredentialRoot = disclose(initialFrozenCredentialRoot);
  registryContractBinding = disclose(initialRegistryContractBinding);
  eventId = disclose(initialEventId);
  // Constructor arguments are public transaction data. The organizer derives
  // this authorization key locally; its secret remains a private witness.
  organizerKey = disclose(initialOrganizerKey);
  countryPolicy = disclose(initialCountryPolicy);
  countryPolicyEnabled = disclose(initialCountryPolicyEnabled);
  minimumAssurance = disclose(initialMinimumAssurance);
  requireAdult = disclose(initialRequireAdult);
  validityReference = disclose(initialValidityReference);

  tally.insert(Choice.YES, 0);
  tally.insert(Choice.NO, 0);
  tally.insert(Choice.ABSTAIN, 0);
  phase = Phase.COMMIT;
  closed = false;
}

// The credential path is checked directly against the exact frozen root
// supplied at deployment; the referendum does not copy registry leaves.
export circuit castVote(): [] {
  assert(phase == Phase.COMMIT, "Voting is not in the commit phase");
  assert(!closed, "Voting is closed");

  assert(
    disclose(holderBindingFromVoter() == holderBinding()),
    "Credential policy not satisfied"
  );

  const leaf = credentialLeaf();
  const path = voterPath();
  assert(disclose(path.leaf == leaf), "Credential policy not satisfied");
  assert(
    disclose(merkleTreePathRoot<16, Bytes<32>>(path) == frozenCredentialRoot),
    "Credential policy not satisfied"
  );
  assert(
    disclose(credentialClaimEpoch() == credentialEpoch),
    "Credential policy not satisfied"
  );
  assert(
    disclose(credentialValidUntil() >= validityReference),
    "Credential policy not satisfied"
  );

  if (countryPolicyEnabled) {
    assert(
      disclose(credentialCountry() == countryPolicy),
      "Credential policy not satisfied"
    );
  }
  if (requireAdult) {
    assert(
      disclose(credentialAgeClass() == 2),
      "Credential policy not satisfied"
    );
  }
  if (minimumAssurance > 0) {
    assert(
      disclose(credentialAssurance() >= minimumAssurance),
      "Credential policy not satisfied"
    );
  }

  const voteNullifier = persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "cico:ref-v2:vote-nullifier:"),
    voterSecret(),
    eventId
  ]);
  assert(
    !spentVoteNullifiers.member(disclose(voteNullifier)),
    "This voter has already voted in this referendum"
  );
  assert(!ballotCommitments.isFull(), "Ballot commitment registry is full");
  spentVoteNullifiers.insert(disclose(voteNullifier));

  ballotCommitments.insert(
    ballotCommitment(voterChoice(), voteSalt())
  );
  issuedVotes.increment(1);
}

export circuit closeVote(): [] {
  assert(
    roleKey(
      pad(32, "cico:referendum-v2:organizer:"),
      organizerSecret()
    ) == organizerKey,
    "Organizer authorization failed"
  );
  assert(phase == Phase.COMMIT, "The referendum is not in the commit phase");
  assert(!closed, "The referendum is already closed");
  phase = Phase.REVEAL;
  closed = true;
}

export circuit revealVote(choice: Choice, salt: Bytes<32>): [] {
  assert(phase == Phase.REVEAL, "Voting is not in the reveal phase");
  assert(closed, "The referendum is not closed");

  const commitment = ballotCommitment(choice, salt);
  const path = revealPath();
  assert(disclose(path.leaf == commitment), "The reveal is invalid");
  assert(
    ballotCommitments.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
    "The reveal is invalid"
  );
  assert(
    !revealedCommitments.member(disclose(commitment)),
    "This ballot has already been revealed"
  );

  revealedCommitments.insert(disclose(commitment));
  const currentTally = tally.lookup(disclose(choice));
  tally.insert(disclose(choice), currentTally + 1 as Uint<32>);
}

export circuit finalizeVote(): [] {
  assert(
    roleKey(
      pad(32, "cico:referendum-v2:organizer:"),
      organizerSecret()
    ) == organizerKey,
    "Organizer authorization failed"
  );
  assert(phase == Phase.REVEAL, "The referendum is not in the reveal phase");
  assert(closed, "The referendum is not closed");
  phase = Phase.FINALIZED;
}
