# Optional overrides for `npm run dev:undeployed`. The command's Vite mode
# already selects the Undeployed runtime when this file is absent.
VITE_APP_MODE=undeployed
VITE_MIDNIGHT_NETWORK=undeployed
VITE_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
VITE_MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
VITE_MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws

# After a successful evidence run, use the public values emitted from the v2
# runtime manifest. Never configure the legacy single-contract address here.
VITE_PASSPORT_V2_API_URL=
