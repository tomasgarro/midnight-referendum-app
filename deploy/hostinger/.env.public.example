# Copy to .env.public.local. This file is used only for Compose interpolation.
# Every value is a release input; render every placeholder before `up`.

CICO_DOMAIN=REPLACE_CICO_DOMAIN
RELAY_DOMAIN=REPLACE_RELAY_DOMAIN
RARIMO_DOMAIN=REPLACE_RARIMO_DOMAIN
UI_ORIGIN=https://REPLACE_UI_DOMAIN

# Use immutable image references (tag@sha256:digest), never a floating tag.
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:REPLACE_CADDY_DIGEST
CICO_IMAGE=midnight-civic-cico:REPLACE_RELEASE@sha256:REPLACE_CICO_DIGEST
RELAYER_IMAGE=midnight-civic-relayer:REPLACE_RELEASE@sha256:REPLACE_RELAYER_DIGEST
RARIMO_IMAGE=rarimo-verificator-svc:v0.3.12-cico-delete-204@sha256:REPLACE_RARIMO_DIGEST
MIDNIGHT_PROOF_IMAGE=midnightntwrk/proof-server:8.1.0@sha256:REPLACE_PROOF_DIGEST
POSTGRES_IMAGE=postgres:16.10-alpine@sha256:REPLACE_POSTGRES_DIGEST
