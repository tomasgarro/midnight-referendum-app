# CICO is intentionally restricted to Midnight Preview.
CICO_NETWORK=preview
CICO_HOST=127.0.0.1
CICO_PORT=8791
CICO_ALLOWED_ORIGINS=http://localhost:4173
CICO_STATE_DIRECTORY=.cico-state

# Trusted self-hosted Rarimo verificator. Keep its private/callback endpoints
# on loopback or a private Docker network; only this narrow CICO façade is public.
CICO_RARIMO_BASE_URL=https://verificator.internal.example
CICO_RARIMO_PRIVATE_HEADERS_JSON={"authorization":"Bearer replace-me"}
CICO_RARIMO_PROOF_PARAMS_ORIGINS=https://passport-proof.example
CICO_RARIMO_PROOF_REQUEST_BASE_URL=https://app.rarime.com/external

# Public registry binding. The text and padded hex values must match exactly.
CICO_ISSUER_ID=cico-rarimo-preview
CICO_ISSUER_ID_HEX=
CICO_CREDENTIAL_EPOCH=1
CICO_REGISTRY_CONTRACT_ADDRESS=
CICO_REGISTRY_ID_HEX=

# Independent secrets. Never reuse RELAYER_SEED or reuse these two values.
CICO_ISSUER_WALLET_SEED=
CICO_ISSUER_ROLE_SECRET=

# Generated credential-registry-v1 directory containing keys/ and zkir/.
CICO_ZK_CONFIG_PATH=../contracts/credential-registry-v1/managed/credential-registry-v1
CICO_PROOF_SERVER_URL=http://localhost:6300
CICO_APPROVED_PROOF_ORIGINS=
CICO_NODE_URL=wss://rpc.preview.midnight.network
CICO_INDEXER_HTTP_URL=https://indexer.preview.midnight.network/api/v4/graphql
CICO_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
CICO_EXPLORER_BASE_URL=https://explorer.preview.midnight.network/tx

# Must match the browser adapter policy. Keep the authorization window short.
CICO_CREDENTIAL_TTL_MS=86400000
CICO_MAXIMUM_ISSUANCE_DELAY_MS=600000
