# Apache configuration for the static Hostinger deployment.
#
# Two things the host does not do on its own.
#
# 1. WebM is served as text/plain. The scan walkthrough ships a WebM first and
#    an MP4 second, so a browser that refuses the mistyped source still plays
#    the fallback -- but it downloads the WebM before discarding it, which is
#    the whole saving thrown away. The MIME type is one line.
#
# 2. There is no SPA fallback. The app is a single document today, so nothing
#    is broken yet; the moment any route other than "/" exists, a refresh or a
#    shared deep link would 404. Routing every non-file request to index.html
#    now means that never becomes a live incident.

<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/wasm .wasm
</IfModule>

# Hashed build assets are immutable: their name changes when their bytes do.
# index.html must never be cached, or a deploy is invisible until the browser
# decides otherwise.
<IfModule mod_headers.c>
  # These are safe for every runtime mode. Do not add X-Frame-Options or a
  # restrictive frame-ancestors policy here: Passport may open this app in its
  # cross-origin in-app browser. A stronger CSP must be generated per deployed
  # mode because Preview/showcase connect to different HTTPS/WSS services.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # camera=(self) because the document journey reads the passport page in this
  # tab. It was camera=() until the journey existed, which would now block the
  # feature outright on this host. Everything else stays denied.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"

  <FilesMatch "\.(js|css|woff2|webp|png|webm|mp4|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Anything that exists on disk is served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else is the application.
  RewriteRule ^ index.html [L]
</IfModule>
