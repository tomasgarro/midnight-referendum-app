# Reviewed Rarimo verificator-svc v0.3.12 derivative configuration.
# Copy to config.yaml and render every placeholder. This file contains a
# database password after rendering and must remain untracked and mode 0600.

log:
  level: info
  disable_sentry: true

db:
  # URL-safe password only; this exact value must match .env.rarimo.local.
  url: "postgres://REPLACE_RARIMO_DB_USER:REPLACE_URL_SAFE_RARIMO_DB_PASSWORD@rarimo-postgres:5432/REPLACE_RARIMO_DB_NAME?sslmode=disable"

listener:
  addr: ":8000"

cop:
  disabled: true
  endpoint: "http://unused.invalid"
  upstream: "http://unused.invalid"
  service_name: verificator-svc
  service_port: 8000

callback:
  # Public HTTPS origin used by the RariMe phone flow. No path or trailing slash.
  url: "https://REPLACE_RARIMO_DOMAIN"

verifier:
  verification_key_path: "/proof_keys/passport.json"
  # Choose once at first launch and keep fixed across restarts.
  allowed_identity_timestamp: REPLACE_FIXED_UNIX_SECONDS
  event_id: "REPLACE_STABLE_DECIMAL_FIELD_VALUE"
  multiproof: false
  preserve_user_id_case: false
  erc_1155: "0x0000000000000000000000000000000000000000"

signature_verification:
  pub_key: "04e29323ad356ab524fa5dbe3e490244e741b4d445ac7d2ee5f321556b3fda616bb9d2f2216fc27e099ab3019103cca872679e130629b2b90ea16cedb2b2136371"

poseidonsmt_root_verifier:
  rpc: "https://l2.rarimo.com"
  contract: "0x479F84502Db545FA8d2275372E0582425204A879"
  request_timeout: 10s

auth:
  # Safe only because the verifier is on private Docker networks and the edge
  # allow-list exposes no private path. The derivative DELETE fix preserves the
  # same boundary while allowing CICO's cleanup request to return 204.
  enabled: false
  addr: "http://unused.invalid"
