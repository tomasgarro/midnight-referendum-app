pragma language_version 0.23;

import CompactStandardLibrary;

// A frozen, append-only credential registry. Leaves are claim-bound
// persistent commitments; the raw holder binding and claims remain private.
export sealed ledger registryId: Bytes<32>;
export sealed ledger issuerId: Bytes<32>;
export sealed ledger credentialEpoch: Uint<64>;
export sealed ledger issuerKey: Bytes<32>;

// The registry is mutable only while enrollment is open. A referendum is
// deployed after freeze and pins the resulting root, so accepting historic
// roots here would allow an issuer to freeze an older cohort accidentally.
// MerkleTree.checkRoot() only accepts the current root; the historic variant
// is intentionally reserved for ballot commitments in the referendum.
export ledger credentials: MerkleTree<16, Bytes<32>>;
export ledger frozenRoot: MerkleTreeDigest;
export ledger frozen: Boolean;
export ledger credentialCount: Counter;

witness issuerSecret(): Bytes<32>;
witness holderBinding(): Bytes<32>;
witness credentialBlind(): Bytes<32>;
witness credentialCountry(): Bytes<32>;
witness credentialAgeClass(): Uint<8>;
witness credentialAssurance(): Uint<8>;
witness credentialValidUntil(): Uint<64>;

circuit roleKey(domain: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([domain, secret]);
}

circuit credentialLeaf(): Bytes<32> {
  return persistentCommit<Vector<8, Bytes<32>>>(
    [
      pad(32, "cico:credential:v1"),
      holderBinding(),
      issuerId,
      credentialCountry(),
      credentialAgeClass() as Bytes<32>,
      credentialAssurance() as Bytes<32>,
      credentialEpoch as Bytes<32>,
      credentialValidUntil() as Bytes<32>
    ],
    credentialBlind()
  );
}

circuit requireIssuer(): [] {
  assert(
    roleKey(pad(32, "cico:registry:issuer:"), issuerSecret()) == issuerKey,
    "Registry authorization failed"
  );
}

constructor(
  initialRegistryId: Bytes<32>,
  initialIssuerId: Bytes<32>,
  initialCredentialEpoch: Uint<64>,
  initialIssuerKey: Bytes<32>,
) {
  registryId = disclose(initialRegistryId);
  issuerId = disclose(initialIssuerId);
  credentialEpoch = disclose(initialCredentialEpoch);
  // Constructor arguments are public transaction data. The issuer derives
  // this authorization key locally; its secret remains a private witness.
  issuerKey = disclose(initialIssuerKey);
  frozen = false;
}

// The leaf is built from private witness claims and a credential blind. The
// issuer never receives a voter secret or holder blind.
export circuit addCredential(): [] {
  requireIssuer();
  assert(!frozen, "Credential registry is frozen");
  assert(!credentials.isFull(), "Credential registry is full");

  credentials.insert(credentialLeaf());
  credentialCount.increment(1);
}

// Attests that `candidateRoot` really is this registry's current root.
//
// It mutates nothing and needs no authorization; anyone may call it. It exists
// so that a root admitted to a referendum can be accompanied, in the SAME
// transaction, by on-chain evidence that the root came from this registry.
//
// Midnight does not yet support cross-contract calls, so a referendum cannot
// perform this check itself. Composing this call with the referendum's
// publishCredentialRoot in one transaction is what makes a fabricated root
// publicly detectable: an admitted root with no matching attestation in its
// own transaction is visibly illegitimate to any auditor or indexer.
export circuit attestCurrentRoot(candidateRoot: MerkleTreeDigest): [] {
  assert(credentials.checkRoot(disclose(candidateRoot)), "Invalid registry root");
}

// HistoricMerkleTree.root() is runtime-only. The issuer supplies the
// canonical root read from the ledger, and the circuit verifies it is one of
// this registry's roots before freezing it.
export circuit freeze(candidateRoot: MerkleTreeDigest): [] {
  requireIssuer();
  assert(!frozen, "Credential registry is already frozen");
  assert(credentials.checkRoot(disclose(candidateRoot)), "Invalid registry root");

  frozenRoot = disclose(candidateRoot);
  frozen = true;
}
